// DevoJK settings: generated by tools/devojk_menu.py - edit the tables there, not this file
{
	menuDef
	{
		name					"devojk_menu"
		fullScreen				1
		rect					0 0 640 480
		visible					0
		focusColor				1 1 1 1
		descX					320
		descY					436
		descScale				0.7
		descColor				1 .682 0 .8
		descAlignment			ITEM_ALIGN_CENTER

		onOpen
		{
			show		page_vulkan
			hide		page_devogi
			setitemcolor	tabs	forecolor	1 .682 0 1
			setitemcolor	tab_vulkan	forecolor	1 1 1 1
		}

		onESC
		{
			play		"sound/interface/button1.wav"
			close		devojk_menu
			open		setup_menu
		}

		itemDef
		{
			name				backdrop
